---
// Hero con layout asimétrico inspirado en el hero de Webhound
// (landingfolio.com/inspiration/post/webhound). Ahora que toda la landing
// usa la misma paleta coral/negro (ver globals.css), este componente solo
// usa los tokens compartidos — sin overrides locales.
import LiveAgentChat from "@/components/ui/LiveAgentChat.astro";
import { WHATSAPP_URL, CALENDLY_URL } from "@/lib/constants";
---

<section id="inicio" class="w-full bg-bg">
  <div class="content-width py-16 md:py-24">
    <div class="grid items-start gap-10 md:grid-cols-[1.1fr_0.9fr] md:gap-14">
      <h1 class="font-serif text-[clamp(36px,4.6vw,68px)] font-semibold leading-[1.05] text-heading">
        Tus mensajes de WhatsApp<br />
        no pueden esperar <em class="text-accent italic">5&nbsp;horas</em>.
      </h1>

      <div class="flex flex-col gap-6 pt-2">
        <p class="max-w-[42ch] font-sans text-[16px] text-body">
          Suma un colaborador que nunca se cansa: funciona 24/7, para que
          dejes de perder tiempo en tareas repetitivas sin siquiera
          notarlo.{" "}
          <a href="#comparacion" class="text-accent">Cómo funciona →</a>
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(124,58,237,0.55)] transition-all hover:bg-accent-hover"
          >
            Cuéntame tu caso por WhatsApp →
          </a>
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-accent-muted/35 bg-bg px-7 py-3.5 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading transition-colors hover:border-accent hover:text-accent"
          >
            Agenda tu diagnóstico gratis
          </a>
        </div>
      </div>
    </div>

    <p class="mt-16 font-sans text-[12px] font-medium uppercase tracking-[0.08em] text-accent-muted">
      Una de las tareas que Ailly resuelve por ti — atención al cliente
    </p>
    <div id="comparacion" class="mt-4 grid gap-5 md:grid-cols-2">
      <div class="overflow-hidden rounded-3xl border border-accent-muted/20 bg-surface">
        <div class="flex items-center justify-between border-b border-accent-muted/15 px-[18px] py-3.5">
          <span class="flex items-center gap-1.5 font-sans text-[12px] font-medium text-nav">
            <span class="h-1.5 w-1.5 rounded-full bg-nav"></span>
            Sin agente
          </span>
          <span class="font-sans text-[11px] font-medium uppercase tracking-[0.06em] text-nav">Sin responder</span>
        </div>
        <div class="flex min-h-[220px] flex-col gap-2.5 p-5">
          <div class="w-fit max-w-[82%] rounded-2xl border border-accent-muted/15 bg-surface-elevated px-3.5 py-2.5 font-sans text-[13px] text-heading">
            ¿Tienen disponibilidad este sábado?
          </div>
          <p class="pl-1 font-sans text-[11px] text-nav">Visto · hace 5 horas · sin respuesta</p>

          <div class="mt-3 w-fit max-w-[82%] rounded-2xl border border-accent-muted/15 bg-surface-elevated px-3.5 py-2.5 font-sans text-[13px] text-heading">
            ¿Hola? ¿Siguen ahí?
          </div>
          <p class="pl-1 font-sans text-[11px] text-nav">Visto · hace 2 horas · sin respuesta</p>

          <div class="mt-auto flex items-center gap-2 rounded-2xl border border-accent-muted/25 bg-bg px-3.5 py-2.5">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-nav"></span>
            <p class="font-sans text-[12px] font-medium text-heading">
              Cliente perdido — escribió a la competencia
            </p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-accent-muted/30 bg-surface">
        <div class="flex items-center justify-between border-b border-accent-muted/20 px-[18px] py-3.5">
          <span class="flex items-center gap-1.5 font-sans text-[12px] text-accent">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Ailly
          </span>
          <span class="font-sans text-[11px] uppercase tracking-[0.06em] text-accent">Pruébalo tú mismo</span>
        </div>
        <LiveAgentChat
          greeting="¡Hola! Escríbeme lo que le escribiría un cliente tuyo — pregúntame por precios, horarios, disponibilidad, lo que sea."
          logClass="flex min-h-[220px] flex-col gap-2.5 p-5"
        />
      </div>
    </div>
    <p class="mt-5 text-center font-sans text-[13px] text-nav/50">
      Uno te hace esperar. El otro cierra la venta.
    </p>
  </div>

  <div class="flex justify-center pb-16">
    <a
      href="#dolores"
      aria-label="Ir a la siguiente sección"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-accent-muted/30 text-accent transition-colors hover:border-accent"
    >
      <svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>
