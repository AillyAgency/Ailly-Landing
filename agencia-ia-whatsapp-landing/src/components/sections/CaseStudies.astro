---
// Sección "Esto es lo que recibirías" — antes se presentaba como 3 "casos de
// éxito" de negocios inventados (nombre, ciudad y captura de WhatsApp
// fabricados como si fueran clientes reales). Reescrita a pedido del usuario:
// nunca simular negocios reales — esto es una vista previa ilustrativa,
// organizada por tipo de negocio, de lo que el prospecto recibiría con Ailly.
import Eyebrow from "@/components/ui/Eyebrow.astro";
import WhatsAppMockup from "@/components/ui/WhatsAppMockup.astro";
import StatBar from "@/components/ui/StatBar.astro";
import MiniStat from "@/components/ui/MiniStat.astro";

const previews = [
  {
    id: "clinica-dental",
    tab: "🦷 Clínica dental",
    title: "Para una clínica dental",
    icon: "🦷",
    systemsTag: "5 sistemas que recibirías",
    metrics: [
      { value: "35%→8%", label: "Inasistencia a citas" },
      { value: "3h/día", label: "Liberadas al equipo" },
      { value: "40%", label: "Citas agendadas fuera de horario" },
      { value: "+12", label: "Pacientes reactivados al mes" },
    ],
    messages: [
      { from: "client", text: "Hola buenas noches, ¿cuánto cuesta el tratamiento con brackets invisibles?", time: "8:15 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "¡Hola! 🙌 Va desde $4.500.000 según el caso. Para el valor exacto necesitamos una valoración con radiografía. ¿Te agendo?", time: "8:15 pm" },
      { from: "client", text: "uy está caro, en otro lado me lo ofrecieron más barato", time: "10:16 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "Te entiendo. La diferencia es el seguimiento con especialista y garantía de retoques. ¿Te muestro el plan a cuotas?", time: "10:16 pm" },
      { from: "client", text: "ah sí, si tienen cuotas me interesa", time: "10:16 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "Manejamos hasta 12 meses sin intereses. Tengo jueves 4:00 pm o viernes 10:00 am. ¿Cuál te sirve?", time: "10:16 pm" },
      { from: "client", text: "Me queda bien el jueves a las 4:00 pm", time: "10:16 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "¡Perfecto! 📅 Quedas agendada jueves 4:00 pm. Te llega recordatorio mañana y 2 horas antes.", time: "10:16 pm" },
    ],
    miniaturas: [
      { icon: "🔄", title: "Reactivación de pacientes", desc: "Detecta pacientes sin visita en +60 días y envía mensaje automático de retorno" },
      { icon: "💳", title: "Seguimiento de cuotas", desc: "Aviso automático 3 días antes de cada cuota de tratamiento" },
      { icon: "⭐", title: "Calificación post-consulta", desc: "24h después de la cita solicita calificación y redirige a Google si es positiva" },
      { icon: "📈", title: "Métricas de conversión", desc: "Qué consultas se convierten en citas y cuánto demora el proceso" },
    ],
  },
  {
    id: "estetica-spa",
    tab: "💆 Estética y spa",
    title: "Para un spa o clínica estética",
    icon: "💆",
    systemsTag: "6 sistemas que recibirías",
    metrics: [
      { value: "4h→30min", label: "Equipo en WhatsApp/día" },
      { value: "+18", label: "Reseñas en Google al mes" },
      { value: "65%", label: "Clientes que vuelven al mes" },
      { value: "70%", label: "Lista de espera convertida" },
    ],
    messages: [
      { from: "client", text: "Hola, buenas noches. Vi que hacen limpieza facial, ¿cuánto cuesta y si tienen para mañana?", time: "10:15 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "¡Hola! 🙌 Sí, el valor es $180.000 e incluye extracción + mascarilla. Para mañana tengo 10:00 am, 2:30 pm o 4:00 pm. ¿Cuál te sirve?", time: "10:15 pm" },
      { from: "client", text: "La de 2:30", time: "10:16 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "Perfecto, quedas agendada mañana a las 2:30 pm. Te llega recordatorio un día antes y otro 2 horas antes. ¿Es tu primera vez con nosotros?", time: "10:16 pm" },
      { from: "client", text: "Primera vez", time: "10:16 pm ✓✓" },
      { from: "agent", badge: "Ailly", text: "¡Bienvenida entonces! 💙 Llega 10 min antes para el registro. Si tienes alguna alergia o usas retinol/ácidos, cuéntamelo antes.", time: "10:16 pm" },
    ],
    miniaturas: [
      { icon: "📋", title: "Lista de espera inteligente", desc: "Si no hay cita, queda en espera y se notifica automático cuando se libera un espacio" },
      { icon: "🎁", title: "Programa de fidelización", desc: "Cada 5 visitas envía un beneficio automático para incentivar la próxima cita" },
      { icon: "📊", title: "Reporte de retención", desc: "Qué clientes volvieron, cuántos se perdieron y cuándo fue su última visita" },
      { icon: "🔔", title: "Alerta de cliente inactivo", desc: "Detecta clientes sin visita en +45 días y activa campaña de reactivación" },
    ],
  },
  {
    id: "veterinaria",
    tab: "🐾 Veterinaria",
    title: "Para una veterinaria",
    icon: "🐾",
    systemsTag: "5 sistemas que recibirías",
    metrics: [
      { value: "Inmediata", label: "Respuesta en urgencias" },
      { value: "10%", label: "Olvidan vacunas (vs. 60% sin sistema)" },
      { value: "+33", label: "Citas preventivas al mes" },
      { value: "5h/día", label: "Liberadas al equipo" },
    ],
    messages: [
      { from: "client", text: "Buenas noches, mi perro lleva 2 días sin comer y está muy decaído, ¿qué hago?", time: "9:08 am ✓✓" },
      { from: "agent", badge: "Ailly", text: "¡Entiendo tu preocupación! 🐾 Eso requiere que lo valore un veterinario directamente. Te conecto ahora mismo — dame un momento.", time: "9:08 am" },
      { from: "client", text: "Muchas gracias", time: "9:08 am ✓✓" },
      { from: "agent", badge: "Veterinario de turno", text: "Hola, cuéntame, ¿ha vomitado o tiene diarrea también?", time: "9:10 am" },
    ],
    miniaturas: [
      { icon: "🚨", title: "Triaje automático", desc: "Detecta urgencias y escala al veterinario disponible en segundos" },
      { icon: "📁", title: "Historial de mascotas", desc: "Base de datos actualizada automáticamente con cada consulta y vacuna" },
      { icon: "📅", title: "Calendario preventivo", desc: "Programa automático vacunas, desparasitación y controles por mascota" },
      { icon: "📊", title: "Panel del equipo", desc: "Carga de trabajo, tipos de consulta y disponibilidad en tiempo real" },
    ],
  },
];
---

<section id="lo-que-recibirias" class="section-padding bg-surface">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Esto es lo que recibirías</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">Así trabajaría para tu negocio</h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Ejemplos ilustrativos por tipo de negocio — no son clientes reales, es
        una muestra de cómo se adapta el sistema al tuyo. Elige el que más se
        parezca a lo que haces.
      </p>
    </div>

    <div
      class="mx-auto mt-10 flex max-w-lg gap-1 rounded-full border border-accent-muted/20 bg-surface-elevated p-1"
      role="tablist"
      aria-label="Ejemplos por tipo de negocio"
    >
      {previews.map((p, i) => (
        <button
          type="button"
          class="case-tab flex-1 rounded-full px-3 py-2.5 text-center font-sans text-[13px] font-medium transition-colors"
          class:list={[i === 0 ? "bg-accent text-heading font-bold" : "text-body hover:text-heading"]}
          data-case-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {p.tab}
        </button>
      ))}
    </div>

    {previews.map((p, i) => (
      <div class="case-panel mt-12" class:list={[i !== 0 ? "hidden" : ""]} data-case-panel={i}>
        <div class="mb-8 flex flex-wrap items-start justify-between gap-6">
          <div>
            <h3 class="text-[22px]">{p.title}</h3>
            <p class="mt-1 font-sans text-[13px] text-body/80">Ejemplo ilustrativo, adaptado a tu negocio</p>
            <span class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-accent-muted/30 bg-accent/10 px-2.5 py-1 font-sans text-[11px] font-semibold text-accent">
              ⚡ {p.systemsTag}
            </span>
          </div>
          <div class="flex flex-wrap gap-3">
            {p.metrics.map((m) => (
              <div class="min-w-[110px] rounded-[10px] border border-accent-muted/20 bg-surface-elevated px-4 py-3">
                <p class="font-serif text-[20px] font-semibold leading-none text-accent">{m.value}</p>
                <p class="mt-1 font-sans text-[10px] leading-tight text-body/70">{m.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="grid gap-5 lg:grid-cols-[280px_1fr]">
          <WhatsAppMockup title="Tu negocio" icon={p.icon} messages={p.messages} />

          <div class="flex flex-col gap-3.5">
            {p.id === "clinica-dental" && (
              <Fragment>
                <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                  <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                  <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">📊 Dashboard semanal</p>
                  <div class="grid grid-cols-3 gap-2">
                    <MiniStat value="47" label="Citas esta semana" tone="positive" />
                    <MiniStat value="4" label="Inasistencias" tone="accent" />
                    <MiniStat value="19" label="Agendadas fuera horario" />
                  </div>
                  <div class="mt-2.5">
                    <StatBar label="Confirmadas" percent={91} tone="positive" />
                    <StatBar label="Reagendadas" percent={18} />
                    <StatBar label="Nuevos pacientes" percent={34} tone="positive" />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3.5">
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">📋 Reporte lunes 7am</p>
                    <div class="rounded-lg bg-bg/40 p-2.5 font-sans text-[11px]">
                      <div class="flex justify-between border-b border-white/5 py-1.5"><span class="text-body/70">Citas agendadas</span><strong class="text-heading">47 <span class="text-[#4CAF7D]">↑12</span></strong></div>
                      <div class="flex justify-between border-b border-white/5 py-1.5"><span class="text-body/70">Inasistencias</span><strong class="text-heading">4 <span class="text-[#4CAF7D]">↓8</span></strong></div>
                      <div class="flex justify-between border-b border-white/5 py-1.5"><span class="text-body/70">Tasa confirmación</span><strong class="text-[#4CAF7D]">91%</strong></div>
                      <div class="flex justify-between py-1.5"><span class="text-body/70">Reactivados</span><strong class="text-[#4CAF7D]">+3</strong></div>
                    </div>
                  </div>
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">🔔 Recordatorio automático</p>
                    <div class="rounded-lg bg-bg/60 p-2.5">
                      <div class="mb-1.5 rounded-md rounded-bl-sm bg-[#1F2C34] px-2.5 py-2 font-sans text-[11px] leading-relaxed text-[#E9EDF0]">
                        Te recordamos tu cita mañana jueves a las 4:00 pm. ¿Confirmamos tu asistencia?
                      </div>
                      <div class="flex justify-between font-sans text-[9px] text-[#8696A0]"><span>Enviado automático · 24h antes</span><span>✓✓</span></div>
                    </div>
                  </div>
                </div>
              </Fragment>
            )}

            {p.id === "estetica-spa" && (
              <Fragment>
                <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                  <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                  <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">📊 Servicios más solicitados</p>
                  <StatBar label="Limpieza facial" percent={78} tone="positive" />
                  <StatBar label="Hidratación" percent={52} />
                  <StatBar label="Peeling químico" percent={38} />
                  <div class="mt-2.5 grid grid-cols-3 gap-2">
                    <MiniStat value="83" label="Citas mes" tone="positive" />
                    <MiniStat value="18" label="Reseñas nuevas" />
                    <MiniStat value="65%" label="Tasa de retorno" tone="accent" />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3.5">
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">🔁 Upsell automático día 25</p>
                    <div class="rounded-lg bg-bg/60 p-2.5 font-sans text-[11px] leading-relaxed text-[#E9EDF0]">
                      Hace 25 días tuviste tu limpieza facial. El ciclo recomendado es mensual. ¿Agendamos la próxima?
                    </div>
                  </div>
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">⭐ Calificación + Google</p>
                    <div class="rounded-lg bg-bg/60 p-2.5 font-sans text-[11px] leading-relaxed text-[#E9EDF0]">
                      ¿Cómo quedaste con tu servicio de hoy? 💙 Califica tu experiencia: ⭐⭐⭐⭐⭐
                    </div>
                    <div class="mt-2 rounded-md bg-[#4CAF7D]/10 px-2 py-1.5 font-sans text-[10px] text-[#4CAF7D]">
                      ✓ Si califica 5★ → recibe link a Google Reviews automático
                    </div>
                  </div>
                </div>
              </Fragment>
            )}

            {p.id === "veterinaria" && (
              <Fragment>
                <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                  <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                  <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">🐾 Ficha de mascota — generada automático</p>
                  <div class="rounded-lg bg-bg/40 p-3 font-sans text-[11px]">
                    <div class="mb-2.5 flex items-center justify-between">
                      <span class="text-[13px] font-bold text-heading">Ejemplo: Max</span>
                      <span class="rounded-full bg-[#4CAF7D]/10 px-2 py-0.5 text-[9px] font-semibold text-[#4CAF7D]">Al día con vacunas</span>
                    </div>
                    <div class="flex gap-1.5 py-0.5"><span class="w-16 shrink-0 text-body/60">Raza</span><span class="font-medium text-body">Golden Retriever</span></div>
                    <div class="flex gap-1.5 py-0.5"><span class="w-16 shrink-0 text-body/60">Edad</span><span class="font-medium text-body">3 años, 4 meses</span></div>
                    <div class="mt-2 border-t border-white/5 pt-2">
                      <p class="mb-1 text-[9px] text-body/60">Próximas vacunas</p>
                      <span class="mr-1 rounded-full bg-accent/10 px-2 py-0.5 text-[9px] font-semibold text-accent">Rabia · 15 ago</span>
                      <span class="rounded-full bg-[#4CAF7D]/10 px-2 py-0.5 text-[9px] font-semibold text-[#4CAF7D]">Parvovirus · oct</span>
                    </div>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3.5">
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">💉 Recordatorio de vacuna</p>
                    <div class="rounded-lg bg-bg/60 p-2.5 font-sans text-[11px] leading-relaxed text-body">
                      Tu mascota tiene pendiente la vacuna contra la rabia el 15 de agosto. ¿Agendamos esta semana?
                    </div>
                  </div>
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">🔍 Seguimiento post-consulta</p>
                    <div class="rounded-lg bg-bg/60 p-2.5 font-sans text-[11px] leading-relaxed text-body">
                      Han pasado 48h desde la consulta. ¿Notaste mejoría? Si hay algún síntoma nuevo, avísanos.
                    </div>
                  </div>
                </div>
              </Fragment>
            )}
          </div>
        </div>

        <div class="mt-5 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
          {p.miniaturas.map((min) => (
            <div class="rounded-2xl border border-accent-muted/20 bg-surface-elevated p-4 transition-colors hover:border-accent-muted/50">
              <p class="text-[18px]">{min.icon}</p>
              <p class="mt-2 font-sans text-[12px] font-semibold text-heading/90">{min.title}</p>
              <p class="mt-1 font-sans text-[11px] leading-relaxed text-body/70">{min.desc}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".case-tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".case-panel"));

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        t.classList.remove("bg-accent", "text-heading", "font-bold");
        t.classList.add("text-body");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.remove("text-body");
      tab.classList.add("bg-accent", "text-heading", "font-bold");
      tab.setAttribute("aria-selected", "true");

      const index = tab.dataset.caseIndex;
      panels.forEach((panel) => {
        panel.classList.toggle("hidden", panel.dataset.casePanel !== index);
      });
    });
  });
</script>
