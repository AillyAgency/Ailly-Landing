---
// Símbolo oficial de Ailly (Brandbook v2.0): la "A" de dos trazos que
// convergen en un rombo verde esmeralda — punto de encuentro entre negocio e
// IA. Reemplaza el monograma dibujado a mano por el asset real del brandbook
// (Ailly/Brandbook/Ailly-Brandbook-v2.pdf, sección 03 y 04 "Sobre oscuro").
// Es un PNG, no SVG — el brandbook prohíbe recolorear o deformar el símbolo,
// así que no expone theming vía CSS vars como antes.
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<img
  src="/images/brand/ailly-symbol.png"
  alt="Ailly"
  width={size}
  height={size}
  class={className}
/>
