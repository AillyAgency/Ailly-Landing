---
// Sección 2 del plan maestro — "dolores delegables". Reemplaza por completo
// el contenido anterior (stats 78%/100x + calculadora de pérdida). Objetivo:
// que el prospecto reconozca sus propias tareas manuales y sienta que Ailly
// ya lo conoce, sin haber hablado con él. Posicionamiento ampliado a 6
// frentes del negocio (ver CLAUDE.md), no solo WhatsApp de atención/citas.
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import { WHATSAPP_URL } from "@/lib/constants";

const blocks = [
  {
    title: "Comunicación y atención al cliente",
    icon: "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z",
    tasks: [
      "Responder preguntas frecuentes repetidamente",
      "Atender WhatsApp, Instagram y Facebook",
      "Enviar mensajes de bienvenida",
      "Resolver consultas sobre horarios, precios y disponibilidad",
    ],
  },
  {
    title: "Agendamiento y coordinación",
    icon: "M8 2V6M16 2V6M3.5 10H20.5M5 4H19C20.1 4 21 4.9 21 6V20C21 21.1 20.1 22 19 22H5C3.9 22 3 21.1 3 20V6C3 4.9 3.9 4 5 4Z",
    tasks: [
      "Agendar, confirmar y recordar citas",
      "Gestionar cancelaciones y reagendamientos",
      "Coordinar horarios entre profesionales",
      "Buscar espacios disponibles manualmente",
    ],
  },
  {
    title: "Facturación, pagos y cobros",
    icon: "M4 4H20V20H4V4ZM8 9H16M8 13H16M8 17H12",
    tasks: [
      "Enviar facturas y recibos",
      "Hacer seguimiento a pagos pendientes",
      "Registrar pagos en Excel o papel",
      "Crear reportes periódicos de ventas",
    ],
  },
  {
    title: "Inventario y operaciones",
    icon: "M21 8L12 3L3 8M21 8L12 13M21 8V16L12 21M12 13L3 8M12 13V21M3 8V16L12 21",
    tasks: [
      "Controlar entradas y salidas de productos",
      "Revisar y actualizar inventarios",
      "Detectar cuándo hacer pedidos",
      "Consultar historiales de compras y proveedores",
    ],
  },
  {
    title: "Clientes y CRM",
    icon: "M17 21V19C17 16.79 15.21 15 13 15H5C2.79 15 1 16.79 1 19V21M23 21V19C23 17.13 21.73 15.51 20 15.06M16 3.13C17.73 3.58 19 5.19 19 7C19 8.81 17.73 10.42 16 10.87M13 7C13 9.21 11.21 11 9 11C6.79 11 5 9.21 5 7C5 4.79 6.79 3 9 3C11.21 3 13 4.79 13 7Z",
    tasks: [
      "Registrar nuevos clientes y sus datos",
      "Consultar manualmente el historial de cada cliente",
      "Detectar clientes que llevan tiempo sin comprar",
      "Hacer seguimiento postventa y recuperar clientes",
    ],
  },
  {
    title: "Administración y marketing",
    icon: "M4 19V10M10 19V5M16 19V13M22 19V8",
    tasks: [
      "Consolidar información de diferentes canales",
      "Crear reportes y calcular comisiones manualmente",
      "Publicar contenido repetitivo en redes",
      "Enviar promociones individualmente",
      "Dar seguimiento a prospectos que no compraron",
    ],
  },
];
---

<section id="dolores" class="section-padding bg-surface">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Te conocemos sin hablar contigo</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        Todo esto lo estás haciendo a mano — y no debería ser así
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Ailly no es solo un agente que contesta WhatsApp. Es como sumar un
        colaborador más a tu equipo — se hace cargo de las tareas manuales
        que le roban tiempo a tu negocio, todos los días.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {blocks.map((block) => (
        <div class="rounded-3xl border border-accent-muted/20 bg-surface-elevated p-7">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent/10 text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={block.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h3 class="mt-5 text-[18px] font-semibold text-heading">{block.title}</h3>
          <ul class="mt-4 flex flex-col gap-2.5">
            {block.tasks.map((task) => (
              <li class="flex items-start gap-2.5 text-[14px] leading-snug text-body/85">
                <span aria-hidden="true" class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent-muted/60"></span>
                {task}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center gap-4 text-center">
      <p class="max-w-xl text-[15px] text-heading/85">
        ¿Te suena familiar? Todo esto se puede delegar a un sistema de IA que
        trabaja para tu negocio 24/7.
      </p>
      <Button href={WHATSAPP_URL} target="_blank">
        Cuéntame cuáles de estas tareas te consumen más tiempo
      </Button>
    </div>
  </div>
</section>
