---
// Sección 7 del plan maestro — calculadora de precio estimado. Reescrita
// 2026-09-09 para el pivote a nicho exclusivo de clínicas: el precio ya no
// se arma sumando módulos sueltos, se define por tamaño real de la clínica
// (mismo modelo de Niveles usado en prospección interna, ver
// Prospectos_high_ticket.txt) — instalación + mensualidad por rango. Los
// módulos elegidos solo personalizan el mensaje de WhatsApp de cierre, no
// afectan el precio mostrado.
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { WHATSAPP_NUMBER } from "@/lib/constants";
import { CLINIC_SIZE_OPTIONS, MODULE_OPTIONS } from "@/lib/pricing";
---

<section id="precio" class="section-padding">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Precio estimado</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        ¿Cuánto costaría en tu clínica?
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Trabajamos 100% a la medida, así que no tenemos una tabla de precios
        fija. Responde 2 preguntas rápidas y te damos un estimado de
        instalación y mensualidad.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl rounded-3xl border border-accent-muted/25 bg-surface-elevated p-6 md:p-10">
      <form id="pricing-calc-form" class="flex flex-col gap-8">
        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            1. ¿Cuántos profesionales o sedes tiene tu clínica?
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {CLINIC_SIZE_OPTIONS.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="radio" name="size" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            2. ¿Qué te gustaría automatizar primero? <span class="font-normal text-body/70">(elige una o varias)</span>
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {MODULE_OPTIONS.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="checkbox" name="task" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(45,155,111,0.55)] transition-all hover:bg-accent-hover"
        >
          Ver mi estimado
        </button>
      </form>

      <div id="pricing-calc-result" class="mt-8 hidden border-t border-accent-muted/15 pt-8">
        <p class="font-sans text-[13px] font-medium uppercase tracking-[0.06em] text-accent">
          Tu estimado
        </p>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <div>
            <p class="font-sans text-[11px] uppercase tracking-[0.06em] text-body/60">Instalación (pago único)</p>
            <p id="pricing-calc-setup" class="mt-1 font-serif text-[clamp(22px,3vw,30px)] font-semibold text-accent"></p>
          </div>
          <div>
            <p class="font-sans text-[11px] uppercase tracking-[0.06em] text-body/60">Mensualidad</p>
            <p id="pricing-calc-monthly" class="mt-1 font-serif text-[clamp(22px,3vw,30px)] font-semibold text-accent"></p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-[13px] text-body">
          Estimado preliminar según el tamaño de tu clínica — el precio real
          se define en tu diagnóstico gratuito.
        </p>
        <a
          id="pricing-calc-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(45,155,111,0.55)] transition-all hover:bg-accent-hover"
        >
          Quiero un diagnóstico gratis →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { CLINIC_SIZE_OPTIONS, MODULE_OPTIONS, getClinicSizeTier, formatCOP } from "@/lib/pricing";
  import { WHATSAPP_NUMBER } from "@/lib/constants";

  const form = document.getElementById("pricing-calc-form") as HTMLFormElement | null;
  const resultEl = document.getElementById("pricing-calc-result");
  const setupEl = document.getElementById("pricing-calc-setup");
  const monthlyEl = document.getElementById("pricing-calc-monthly");
  const whatsappEl = document.getElementById("pricing-calc-whatsapp") as HTMLAnchorElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const size = String(data.get("size") ?? "1");
    const tasks = data.getAll("task").map(String);

    if (tasks.length === 0) {
      alert("Elige al menos una tarea para automatizar.");
      return;
    }

    const tier = getClinicSizeTier(size);

    if (setupEl) setupEl.textContent = `${formatCOP(tier.setupLow)} – ${formatCOP(tier.setupHigh)}`;
    if (monthlyEl) monthlyEl.textContent = `${formatCOP(tier.monthlyLow)} – ${formatCOP(tier.monthlyHigh)} / mes`;
    resultEl?.classList.remove("hidden");
    resultEl?.scrollIntoView({ behavior: "smooth", block: "nearest" });

    const sizeLabel = CLINIC_SIZE_OPTIONS.find((o) => o.value === size)?.label ?? "";
    const taskLabels = tasks
      .map((task) => MODULE_OPTIONS.find((o) => o.value === task)?.label ?? task)
      .join(", ");

    const message = `Hola, quiero un diagnóstico gratis para mi clínica. Hice la calculadora de precio: ${sizeLabel}, y me interesa automatizar primero: ${taskLabels}.`;

    if (whatsappEl) {
      whatsappEl.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
    }
  });
</script>
