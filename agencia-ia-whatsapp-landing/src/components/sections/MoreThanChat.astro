---
// Sección que amplía la promesa de SolutionSection: no es solo atención de
// entrada, es un sistema con 6 capacidades reales que cubren venta,
// retención, reportes y confiabilidad operativa.
import Eyebrow from "@/components/ui/Eyebrow.astro";

const capabilities = [
  {
    title: "Reportes automáticos",
    text: "Cada semana recibes un resumen claro: citas agendadas, tasa de cierre, inasistencias, ingresos estimados. Números reales de tu negocio, sin revisar conversación por conversación.",
    icon: "M4 19V10M10 19V5M16 19V13M22 19V8",
  },
  {
    title: "Memoria de cada cliente",
    text: "El sistema reconoce a quien ya escribió antes y retoma el contexto. Se siente como hablar con alguien que te conoce, no con una máquina que empieza de cero cada vez.",
    icon: "M12 21C12 21 4 16.5 4 10.5C4 7.46 6.46 5 9.5 5C10.9 5 12 5.7 12 5.7C12 5.7 13.1 5 14.5 5C17.54 5 20 7.46 20 10.5C20 16.5 12 21 12 21Z",
  },
  {
    title: "Todo el ciclo de la cita",
    text: "Agenda, cancela y reprograma, todo desde el mismo chat. Nadie de tu equipo tiene que intervenir a mano para mover una cita.",
    icon: "M4 4V9H4.582M20 20V15H19.418M4.582 9C5.245 6.694 7.226 5 9.7 5C11.9 5 13.8 6.2 14.8 8M19.418 15C18.755 17.306 16.774 19 14.3 19C12.1 19 10.2 17.8 9.2 16",
  },
  {
    title: "Seguimiento después del servicio",
    text: "Pide la reseña automáticamente al terminar, y detecta cuando un cliente lleva tiempo sin volver para reactivarlo. No solo atiende al que llega — trae de vuelta a los que ya te conocen.",
    icon: "M3 6L11.36 12.26C11.75 12.55 12.25 12.55 12.64 12.26L21 6M4.5 19H19.5C20.33 19 21 18.33 21 17.5V6.5C21 5.67 20.33 5 19.5 5H4.5C3.67 5 3 5.67 3 6.5V17.5C3 18.33 3.67 19 4.5 19Z",
  },
  {
    title: "Diseñado para no fallar",
    text: "Si una integración falla, el sistema reintenta solo y te avisa antes de que lo note tu negocio. No es un experimento que se cae en silencio — es infraestructura pensada para producción.",
    icon: "M12 3L19 6V11C19 15.42 16.06 19.44 12 21C7.94 19.44 5 15.42 5 11V6L12 3Z",
  },
  {
    title: "Panel de control simple",
    text: "Citas de hoy, próximos días y alertas, todo en una sola vista. Sin entrar a cinco apps distintas para saber cómo va tu negocio.",
    icon: "M4 4H10V10H4V4ZM14 4H20V10H14V4ZM4 14H10V20H4V14ZM14 14H20V20H14V14Z",
  },
];
---

<section id="sistema-completo" class="section-padding bg-surface">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Más que un chat</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        Un sistema completo, no solo un chatbot que contesta
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Atender el primer mensaje es apenas el punto de entrada. Esto es lo
        que sigue pasando por detrás, todos los días, sin que tengas que
        pensarlo.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((item) => (
        <div class="rounded-2xl border border-accent-muted/20 bg-surface-elevated p-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent/10 text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={item.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h3 class="mt-5 text-[19px] font-semibold text-heading">{item.title}</h3>
          <p class="mt-3 text-[14px] leading-relaxed text-body/85">{item.text}</p>
        </div>
      ))}
    </div>

    <p class="mx-auto mt-12 max-w-2xl text-center text-[15px] leading-relaxed text-heading/85">
      No pagas por tener un chatbot activo — pagas por lo que te retribuye:
      tiempo que dejas de perder, clientes que no se te van, citas que no se
      caen, y decisiones que ya no dependes de la intuición.
    </p>
  </div>
</section>
