---
// Badge tipo pill con punto de acento — patrón de "eyebrow" tomado del
// template Marble (etiquetas redondeadas sobre los títulos de sección).
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<p
  class={`inline-flex w-fit items-center gap-2 rounded-full border border-accent-muted/25 bg-surface-elevated px-4 py-1.5 font-sans text-[12px] font-bold uppercase tracking-[0.08em] text-accent-muted ${className}`}
>
  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
  <slot />
</p>
