---
// Sección 7 del plan maestro — calculadora de precio estimado, 3
// preguntas de selección única. Fórmula aditiva definida en Precios.md
// (raíz del repo): precio = base(módulo) + ajuste(personas) + ajuste(mensajes).
// Sin planes/tiers fijos ni formulario de captación aparte: el botón de
// WhatsApp final con el resumen prellenado ES la captación real.
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { WHATSAPP_NUMBER } from "@/lib/constants";
import { TEAM_OPTIONS, MESSAGES_OPTIONS, MODULE_OPTIONS } from "@/lib/pricing";
---

<section id="precio" class="section-padding">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Precio estimado</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        ¿Cuánto costaría en tu negocio?
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Trabajamos 100% a la medida, así que no tenemos una tabla de precios
        fija. Responde 3 preguntas rápidas y te damos un estimado.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl rounded-3xl border border-accent-muted/25 bg-surface-elevated p-6 md:p-10">
      <form id="pricing-calc-form" class="flex flex-col gap-8">
        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            1. ¿Cuántas personas trabajan en tu negocio?
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {TEAM_OPTIONS.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="radio" name="team" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            2. ¿Cuántos mensajes de WhatsApp recibe al día?
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {MESSAGES_OPTIONS.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="radio" name="msgs" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            3. ¿Qué te gustaría automatizar primero? <span class="font-normal text-body/70">(elige una o varias)</span>
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {MODULE_OPTIONS.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="checkbox" name="task" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(45,155,111,0.55)] transition-all hover:bg-accent-hover"
        >
          Ver mi estimado
        </button>
      </form>

      <div id="pricing-calc-result" class="mt-8 hidden border-t border-accent-muted/15 pt-8">
        <p class="font-sans text-[13px] font-medium uppercase tracking-[0.06em] text-accent">
          Tu estimado
        </p>
        <p id="pricing-calc-range" class="mt-2 font-serif text-[clamp(28px,4vw,40px)] font-semibold text-accent"></p>
        <p class="mt-3 max-w-md text-[13px] text-body">
          Estimado preliminar — el precio real se define en tu diagnóstico
          gratuito.
        </p>
        <a
          id="pricing-calc-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(45,155,111,0.55)] transition-all hover:bg-accent-hover"
        >
          Quiero un diagnóstico gratis →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { TEAM_OPTIONS, MESSAGES_OPTIONS, MODULE_OPTIONS, calcularPrecio, formatCOP } from "@/lib/pricing";
  import { WHATSAPP_NUMBER } from "@/lib/constants";

  const form = document.getElementById("pricing-calc-form") as HTMLFormElement | null;
  const resultEl = document.getElementById("pricing-calc-result");
  const rangeEl = document.getElementById("pricing-calc-range");
  const whatsappEl = document.getElementById("pricing-calc-whatsapp") as HTMLAnchorElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const team = String(data.get("team") ?? "0");
    const msgs = String(data.get("msgs") ?? "0");
    const tasks = data.getAll("task").map(String);

    if (tasks.length === 0) {
      alert("Elige al menos una tarea para automatizar.");
      return;
    }

    const precio = calcularPrecio(team, msgs, tasks);
    const low = precio * 0.9;
    const high = precio * 1.1;

    if (rangeEl) rangeEl.textContent = `${formatCOP(low)} – ${formatCOP(high)} COP`;
    resultEl?.classList.remove("hidden");
    resultEl?.scrollIntoView({ behavior: "smooth", block: "nearest" });

    const teamLabel = TEAM_OPTIONS.find((o) => o.value === team)?.label ?? "";
    const msgsLabel = MESSAGES_OPTIONS.find((o) => o.value === msgs)?.label ?? "";
    const taskLabels = tasks
      .map((task) => MODULE_OPTIONS.find((o) => o.value === task)?.label ?? task)
      .join(", ");

    const message = `Hola, quiero un diagnóstico gratis para mi negocio. Hice la calculadora de precio: equipo ${teamLabel}, ${msgsLabel} mensajes de WhatsApp al día, y me interesa automatizar primero: ${taskLabels}.`;

    if (whatsappEl) {
      whatsappEl.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
    }
  });
</script>
