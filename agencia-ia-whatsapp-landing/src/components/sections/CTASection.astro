---
import Button from "@/components/ui/Button.astro";
import { WHATSAPP_URL, CALENDLY_EMBED_URL } from "@/lib/constants";
---

<section id="cta-final" class="section-padding bg-[radial-gradient(120%_100%_at_50%_0%,rgba(45,155,111,0.16),transparent_60%)]">
  <div class="content-width text-center">
    <h2 class="mx-auto max-w-2xl text-[clamp(30px,5.5vw,60px)]">
      Deja de hacer a mano lo que un aliado de IA puede hacer por ti.
      <br />
      Agenda tu diagnóstico gratuito.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
      Volvamos a donde empezamos: cada tarea repetitiva que sigues haciendo a
      mano le resta tiempo a hacer crecer tu negocio. Elige cómo prefieres
      dar el primer paso.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button href={WHATSAPP_URL} target="_blank" class="w-full sm:w-auto">
        Escríbeme por WhatsApp
      </Button>
      <Button href="#agendar" variant="ghost" class="w-full sm:w-auto">
        Agenda tu diagnóstico en Calendly
      </Button>
    </div>

    <div id="agendar" class="mt-16 overflow-hidden rounded-3xl border border-accent-muted/25 bg-surface-elevated">
      <div
        class="calendly-inline-widget"
        data-url={CALENDLY_EMBED_URL}
        style="min-width:320px;height:700px;"
      >
      </div>
    </div>
  </div>
</section>

<script
  type="text/javascript"
  src="https://assets.calendly.com/assets/external/widget.js"
  async
></script>
