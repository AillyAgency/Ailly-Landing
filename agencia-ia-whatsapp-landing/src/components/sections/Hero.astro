---
import HeroMedia from "@/components/sections/HeroMedia.astro";
import StaircaseHeading from "@/components/ui/StaircaseHeading.astro";
import Button from "@/components/ui/Button.astro";
import { WHATSAPP_URL } from "@/lib/constants";

const trustItems = [
  "Disponible 24/7",
  "Respuestas consistentes",
  "Conversaciones seguras",
];
---

<section id="inicio" class="content-width pb-10 pt-12 md:pt-20">
  <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
    <div class="order-2 md:order-1">
      <span class="inline-flex items-center gap-2 rounded-full border border-accent-muted/40 px-4 py-1.5 font-sans text-[12px] font-medium uppercase tracking-[0.08em] text-accent">
        Agente de WhatsApp con IA
      </span>

      <StaircaseHeading as="h1" class="mt-6 text-[clamp(32px,6.5vw,76px)]">
        <span class="line">No pierdas más clientes</span>
        <span class="line">por responder tarde</span>
        <span class="line">a tus mensajes de WhatsApp.</span>
        <span class="line">Nosotros respondemos por ti, <span class="accent">siempre</span>.</span>
      </StaircaseHeading>

      <p class="mt-8 max-w-md font-sans text-[clamp(15px,1.6vw,18px)] text-body">
        Un agente de IA que responde tu WhatsApp en segundos, 24/7 — antes de
        que el cliente se vaya con la competencia.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <Button href={WHATSAPP_URL} target="_blank">Habla con nosotros</Button>
        <a
          href="#como-funciona"
          class="font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-nav transition-colors hover:text-accent"
        >
          Ver cómo funciona
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
        {trustItems.map((item) => (
          <li class="flex items-center gap-2 font-sans text-[13px] text-nav">
            <span class="h-1 w-1 rounded-full bg-accent"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="order-1 md:order-2">
      <HeroMedia />
    </div>
  </div>

  <div class="mt-16 flex justify-center md:mt-24">
    <a
      href="#como-funciona"
      aria-label="Ir a cómo funciona"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-accent-muted/30 text-accent transition-colors hover:border-accent"
    >
      <svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>
