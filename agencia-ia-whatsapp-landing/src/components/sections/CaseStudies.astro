---

<section id="casos-de-exito" class="section-padding bg-surface">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Casos de éxito</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">Negocios que trabajan diferente</h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Lo que Ailly construye no es solo un bot — es un sistema completo operando
        en segundo plano.
      </p>
    </div>

    <div
      class="mx-auto mt-10 flex max-w-lg gap-1 rounded-xl border border-accent-muted/20 bg-surface-elevated p-1"
      role="tablist"
      aria-label="Casos de éxito"
    >
      {cases.map((c, i) => (
        <button
          type="button"
          class="case-tab flex-1 rounded-lg px-3 py-2.5 text-center font-sans text-[13px] font-medium transition-colors"
          class:list={[i === 0 ? "bg-accent text-bg font-semibold" : "text-body hover:text-heading"]}
          data-case-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {c.tab}
        </button>
      ))}
    </div>

    {cases.map((c, i) => (
      <div class="case-panel mt-12" class:list={[i !== 0 ? "hidden" : ""]} data-case-panel={i}>
        <div class="mb-8 flex flex-wrap items-start justify-between gap-6">
          <div>
            <h3 class="text-[22px]">{c.name}</h3>
            <p class="mt-1 font-sans text-[13px] text-body/80">{c.location}</p>
            <span class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-accent-muted/30 bg-accent/10 px-2.5 py-1 font-sans text-[11px] font-semibold text-accent">
              ⚡ {c.systemsTag}
            </span>
          </div>
          <div class="flex flex-wrap gap-3">
            {c.metrics.map((m) => (
              <div class="min-w-[110px] rounded-[10px] border border-accent-muted/20 bg-surface-elevated px-4 py-3">
                <p class="font-serif text-[20px] font-semibold leading-none text-accent">{m.value}</p>
                <p class="mt-1 font-sans text-[10px] leading-tight text-body/70">{m.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="grid gap-5 lg:grid-cols-[280px_1fr]">
          <WhatsAppMockup name={c.name} avatarInitials={c.avatarInitials} avatarColor={c.avatarColor} messages={c.messages} />

          <div class="flex flex-col gap-3.5">
            {c.id === "sonrisa-total" && (
              <Fragment>
                <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                  <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                  <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">📊 Dashboard semanal</p>
                  <div class="grid grid-cols-3 gap-2">
                    <MiniStat value="47" label="Citas esta semana" tone="positive" />
                    <MiniStat value="4" label="Inasistencias" tone="accent" />
