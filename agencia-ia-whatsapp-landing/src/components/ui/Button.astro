---
interface Props {
  href: string;
  variant?: "primary" | "ghost";
  class?: string;
  target?: "_blank" | "_self";
}

const { href, variant = "primary", class: className = "", target } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] transition-all duration-200 min-h-[44px]";

const variants = {
  primary:
    "bg-accent text-heading shadow-[0_8px_28px_-6px_rgba(124,58,237,0.55)] hover:bg-accent-hover hover:shadow-[0_12px_36px_-6px_rgba(124,58,237,0.7)]",
  ghost:
    "bg-bg text-heading border border-accent-muted/25 hover:border-accent hover:text-accent",
};
---

<a
  href={href}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  class={`${base} ${variants[variant]} ${className}`}
>
  <slot />
</a>
