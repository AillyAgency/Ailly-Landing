---
export const prerender = true;

import BaseLayout from "@/components/layout/BaseLayout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import PainSection from "@/components/sections/PainSection.astro";
import BeforeAfterSection from "@/components/sections/BeforeAfterSection.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import IndustryExamples from "@/components/sections/IndustryExamples.astro";
import CaseStudies from "@/components/sections/CaseStudies.astro";
import PricingCalculator from "@/components/sections/PricingCalculator.astro";
import FAQSection from "@/components/sections/FAQSection.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<BaseLayout>
  <Navbar />
  <main>
    <Hero />
    <PainSection />
    <BeforeAfterSection />
    <HowItWorks />
    <IndustryExamples />
    <CaseStudies />
    <PricingCalculator />
    <FAQSection />
    <CTASection />
  </main>
  <Footer />
</BaseLayout>
