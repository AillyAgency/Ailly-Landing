---
// Sección 7 del plan maestro — calculadora de precio estimado, versión
// liviana de 3 preguntas. Sin captación de nombre/WhatsApp por formulario:
// el botón de WhatsApp final ES la captación real. Tiers de precio
// confirmados con el usuario (ver blueprint, sección 3.7).
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { WHATSAPP_NUMBER } from "@/lib/constants";

const teamOptions = [
  { value: "0", label: "Solo yo" },
  { value: "1", label: "2 a 5 personas" },
  { value: "2", label: "6 a 15 personas" },
  { value: "3", label: "Más de 15 personas" },
];

const msgsOptions = [
  { value: "0", label: "Menos de 20" },
  { value: "1", label: "20 a 50" },
  { value: "2", label: "50 a 100" },
  { value: "3", label: "Más de 100" },
];

const taskOptions = [
  { value: "Atención y agendamiento por WhatsApp", label: "Atención y agendamiento por WhatsApp" },
  { value: "Facturación y cobros", label: "Facturación y cobros" },
  { value: "Inventario y operaciones", label: "Inventario y operaciones" },
  { value: "Clientes y seguimiento (CRM)", label: "Clientes y seguimiento (CRM)" },
  { value: "Reportes y administración", label: "Reportes y administración" },
  { value: "Todo el sistema completo", label: "Todo el sistema completo" },
];
---

<section id="precio" class="section-padding">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Precio estimado</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        ¿Cuánto costaría en tu negocio?
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Trabajamos 100% a la medida, así que no tenemos una tabla de precios
        fija. Responde 3 preguntas rápidas y te damos un estimado.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl rounded-3xl border border-accent-muted/25 bg-surface-elevated p-6 md:p-10">
      <form id="pricing-calc-form" class="flex flex-col gap-8">
        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            1. ¿Cuántas personas trabajan en tu negocio?
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {teamOptions.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="radio" name="team" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            2. ¿Cuántos mensajes de WhatsApp recibe al día?
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {msgsOptions.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="radio" name="msgs" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="font-sans text-[14px] font-medium text-heading">
            3. ¿Qué te gustaría automatizar primero?
          </legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {taskOptions.map((opt, i) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-2xl border border-accent-muted/25 bg-surface px-4 py-3 text-[14px] text-body transition-colors has-[:checked]:border-accent has-[:checked]:text-heading">
                <input type="radio" name="task" value={opt.value} checked={i === 0} class="accent-accent" />
                {opt.label}
              </label>
            ))}
          </div>
        </fieldset>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(124,58,237,0.55)] transition-all hover:bg-accent-hover"
        >
          Ver mi estimado
        </button>
      </form>

      <div id="pricing-calc-result" class="mt-8 hidden border-t border-accent-muted/15 pt-8">
        <p class="font-sans text-[13px] font-medium uppercase tracking-[0.06em] text-accent">
          Tu estimado
        </p>
        <p id="pricing-calc-tier" class="mt-2 text-[20px] font-semibold text-heading"></p>
        <p id="pricing-calc-range" class="mt-1 font-serif text-[clamp(28px,4vw,40px)] font-semibold text-accent"></p>
        <p class="mt-3 max-w-md text-[13px] text-body">
          Estimado preliminar — el precio real se define en tu diagnóstico
          gratuito, con base en lo que necesita tu negocio.
        </p>
        <a
          id="pricing-calc-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 font-sans text-[13px] font-bold uppercase tracking-[0.06em] text-heading shadow-[0_8px_28px_-6px_rgba(124,58,237,0.55)] transition-all hover:bg-accent-hover"
        >
          Quiero un diagnóstico gratis →
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ WHATSAPP_NUMBER }}>
  const form = document.getElementById("pricing-calc-form");
  const resultEl = document.getElementById("pricing-calc-result");
  const tierEl = document.getElementById("pricing-calc-tier");
  const rangeEl = document.getElementById("pricing-calc-range");
  const whatsappEl = document.getElementById("pricing-calc-whatsapp");

  const TIERS = [
    { name: "Básico", range: "$1.300.000 – $1.800.000 COP/mes" },
    { name: "Estándar", range: "$1.800.000 – $2.500.000 COP/mes" },
    { name: "Avanzado", range: "$2.500.000 – $3.500.000 COP/mes" },
  ];

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const team = Number(data.get("team") ?? 0);
    const msgs = Number(data.get("msgs") ?? 0);
    const task = String(data.get("task") ?? "");

    let tierIndex;
    if (team === 3 || msgs === 3) {
      tierIndex = 2; // Avanzado
    } else if (team <= 1 && msgs <= 1) {
      tierIndex = 0; // Básico
    } else {
      tierIndex = 1; // Estándar
    }
    const tier = TIERS[tierIndex];

    if (tierEl) tierEl.textContent = `Plan ${tier.name}`;
    if (rangeEl) rangeEl.textContent = tier.range;
    resultEl?.classList.remove("hidden");
    resultEl?.scrollIntoView({ behavior: "smooth", block: "nearest" });

    const message = `Hola, quiero un diagnóstico gratis para mi negocio. Hice la calculadora de precio: equipo ${
      ["solo yo", "2-5 personas", "6-15 personas", "más de 15 personas"][team]
    }, ${
      ["menos de 20", "20-50", "50-100", "más de 100"][msgs]
    } mensajes de WhatsApp al día, y me interesa automatizar primero: ${task}.`;

    if (whatsappEl) {
      whatsappEl.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
    }
  });
</script>
