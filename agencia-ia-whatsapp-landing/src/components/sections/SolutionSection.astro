---
// Sección de contraste (patrón tomado de la segunda sección del template
// de referencia: dos tarjetas lado a lado). Contenido provisional — a la
// espera de las especificaciones de copy del usuario.
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";

const genericBullets = [
  "Sigue un árbol de opciones rígido",
  "No entiende variaciones de la misma pregunta",
  "No distingue quién está listo para comprar",
  "Se queda corto apenas la conversación se sale del guion",
];

const ourBullets = [
  "Entiende la pregunta, la diga como la diga el cliente",
  "Responde dudas y cualifica en la misma conversación",
  "Aprende el tono y la información real de tu negocio",
  "Te entrega la conversación lista para cerrar",
];
---

<section id="solucion" class="section-padding">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">Cómo se diferencia</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        Un solo sistema para <span class="text-accent">atender</span> y <span class="text-accent">vender</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        No es solo un chatbot que contesta — es el sistema que convierte cada
        mensaje en una oportunidad cerrada, sin que se te escape ninguna
        venta por falta de atención a tiempo.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-accent-muted/15 bg-surface p-8">
        <p class="flex items-center gap-2 font-sans text-[13px] text-nav/60">
          <span class="h-1.5 w-1.5 rounded-full bg-nav/60"></span>
          Chatbot genérico
        </p>
        <ul class="mt-6 flex flex-col gap-4">
          {genericBullets.map((item) => (
            <li class="flex items-start gap-3 text-[14px] text-body/80">
              <span aria-hidden="true" class="mt-0.5 text-nav/50">–</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-accent-muted/35 bg-surface-elevated p-8">
        <p class="flex items-center gap-2 font-sans text-[13px] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Ailly
        </p>
        <ul class="mt-6 flex flex-col gap-4">
          {ourBullets.map((item) => (
            <li class="flex items-start gap-3 text-[14px] text-heading">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0" aria-hidden="true">
                <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" class="text-accent" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <Button href="#casos-de-exito" variant="ghost">
        Compruébalo con conversaciones reales →
      </Button>
    </div>
  </div>
</section>
