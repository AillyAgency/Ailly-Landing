---
// Sección 4 del plan maestro — proceso real de trabajar con Ailly. Ya no es
// el flujo genérico "conectamos / responde / cierras" — ahora describe
// diagnóstico → propuesta → demo → comparación de resultados.
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { WHATSAPP_URL, CALENDLY_URL } from "@/lib/constants";

const steps = [
  {
    number: "01",
    title: "Llamada gratuita de diagnóstico",
    text: "Hablamos de tu negocio: qué tareas te consumen más tiempo hoy y dónde se te están escapando clientes por falta de respuesta a tiempo.",
    icon: "M3 6L11.36 12.26C11.75 12.55 12.25 12.55 12.64 12.26L21 6M4.5 19H19.5C20.33 19 21 18.33 21 17.5V6.5C21 5.67 20.33 5 19.5 5H4.5C3.67 5 3 5.67 3 6.5V17.5C3 18.33 3.67 19 4.5 19Z",
  },
  {
    number: "02",
    title: "Propuesta a la medida de tu negocio",
    text: "Con lo que nos contaste, armamos una propuesta concreta — qué automatizar primero y qué resultado puedes esperar, nada genérico.",
    icon: "M9 12H15M9 16H15M9 8H15M5 4H19C20.1 4 21 4.9 21 6V20C21 21.1 20.1 22 19 22H5C3.9 22 3 21.1 3 20V6C3 4.9 3.9 4 5 4Z",
  },
  {
    number: "03",
    title: "Demo del sistema que te sirve",
    text: "Te mostramos funcionando el sistema específico para tu caso, no una presentación genérica — lo ves trabajar antes de decidir.",
    icon: "M12 3L19 6V11C19 15.42 16.06 19.44 12 21C7.94 19.44 5 15.42 5 11V6L12 3Z",
  },
  {
    number: "04",
    title: "Comparas el antes y el después",
    text: "Ves lado a lado cómo rinde tu equipo hoy y cómo rendiría con Ailly trabajando — tiempo liberado, clientes atendidos, oportunidades que ya no se pierden.",
    icon: "M4 19V10M10 19V5M16 19V13M22 19V8",
  },
];
---

<section id="como-funciona" class="section-padding bg-surface">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">El proceso</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">Cómo funciona</h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        Nada de contratos a ciegas — primero entendemos tu negocio, después
        te mostramos exactamente cómo va a funcionar en él.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <div class="relative overflow-hidden rounded-2xl border border-accent-muted/20 bg-surface-elevated p-7">
          <div class="absolute inset-x-0 top-0 h-[3px] bg-accent"></div>
          <p class="font-serif text-[15px] font-semibold text-accent-muted">{step.number}</p>
          <span class="mt-4 flex h-11 w-11 items-center justify-center rounded-full bg-accent/10 text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={step.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h3 class="mt-5 text-[18px] font-semibold text-heading">{step.title}</h3>
          <p class="mt-3 text-[14px] leading-relaxed text-body/85">{step.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button href={WHATSAPP_URL} target="_blank">Escríbeme para empezar</Button>
      <Button href={CALENDLY_URL} target="_blank" variant="ghost">
        Agenda tu diagnóstico gratis
      </Button>
    </div>
  </div>
</section>
