---
import AillyLogo from "@/components/ui/AillyLogo.astro";
import { WHATSAPP_URL } from "@/lib/constants";

const links = [
  { href: "#dolores", label: "Qué delegas" },
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#industrias", label: "Industrias" },
  { href: "#precio", label: "Precio" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-accent-muted/15 bg-bg/90 backdrop-blur">
  <nav class="content-width flex items-center justify-between py-5">
    <a href="#inicio" class="flex items-center gap-2.5">
      <AillyLogo size={28} />
      <span class="font-sans text-[17px] font-bold text-heading">
        Ai<span class="text-accent">lly</span>
      </span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-nav transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-[10px] border border-accent-muted/40 px-5 py-2.5 font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-nav transition-colors hover:border-accent hover:text-accent md:inline-flex"
    >
      Contáctanos
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 md:hidden"
    >
      <span class="h-px w-6 bg-heading transition-transform"></span>
      <span class="h-px w-6 bg-heading transition-opacity"></span>
      <span class="h-px w-6 bg-heading transition-transform"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-accent-muted/15 bg-bg px-6 pb-6 pt-2 md:hidden"
  >
    {links.map((link) => (
      <a
        href={link.href}
        class="py-3 font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-nav transition-colors hover:text-accent"
      >
        {link.label}
      </a>
    ))}
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 rounded-[10px] border border-accent-muted/40 px-5 py-3 text-center font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-nav hover:border-accent hover:text-accent"
    >
      Contáctanos
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
