---
import Eyebrow from "@/components/ui/Eyebrow.astro";

const stats = [
  {
    number: "78%",
    text: "de los clientes compra con la primera empresa que le responde, sin importar si tenía el mejor precio.",
  },
  {
    number: "100x",
    text: "más probable cerrar un lead si lo contactas en los primeros 5 minutos, frente a esperar 30.",
  },
  {
    number: "5h+",
    text: "es lo que tarda en promedio un negocio en responder un mensaje de un cliente.",
  },
];
---

<section class="section-padding bg-surface">
  <div class="content-width">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow class="mx-auto justify-center">El problema</Eyebrow>
      <h2 class="mt-4 text-[clamp(30px,5.5vw,60px)]">
        El costo silencioso de no responder a tiempo
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(15px,1.6vw,18px)]">
        No es falta de interés de tus clientes — es falta de capacidad para
        atenderlos a todos, a tiempo, todo el tiempo.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      {stats.map((stat) => (
        <div class="rounded-2xl border border-accent-muted/25 bg-surface-elevated p-8">
          <p class="font-serif text-[clamp(36px,4vw,48px)] font-semibold text-accent">
            {stat.number}
          </p>
          <p class="mt-3 text-[15px] text-body">{stat.text}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-[12px] text-body/70">
      Fuentes: Lead Response Management Study (Kellogg School of Management /
      InsideSales.com); benchmarks de tiempos de respuesta en atención al
      cliente.
    </p>

    <div class="mt-14 rounded-2xl border border-accent-muted/25 bg-surface-elevated p-8 md:p-10">
      <h3 class="text-xl md:text-2xl">Calcula cuánto podrías estar perdiendo</h3>
      <p class="mt-2 max-w-xl text-[14px] text-body">
        Con tus propios números, no con una cifra genérica. Ajusta los datos
        de tu negocio:
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <label class="block">
          <span class="font-sans text-[13px] font-medium uppercase tracking-[0.06em] text-nav">
            Valor de tu servicio más barato (COP)
          </span>
          <div class="mt-2 flex items-center gap-2 rounded-[10px] border border-accent-muted/30 bg-surface px-4 py-3">
            <span class="text-body">$</span>
            <input
              id="calc-ticket"
              type="number"
              min="0"
              step="1000"
              value="80000"
              class="w-full bg-transparent font-sans text-[16px] text-heading outline-none"
            />
          </div>
        </label>

        <label class="block">
          <span class="font-sans text-[13px] font-medium uppercase tracking-[0.06em] text-nav">
            Clientes que no recibieron atención inmediata (al día)
          </span>
          <div class="mt-2 flex items-center gap-2 rounded-[10px] border border-accent-muted/30 bg-surface px-4 py-3">
            <input
              id="calc-missed"
              type="number"
              min="0"
              step="1"
              value="1"
              class="w-full bg-transparent font-sans text-[16px] text-heading outline-none"
            />
          </div>
        </label>
      </div>

      <div class="mt-8 border-t border-accent-muted/15 pt-8">
        <p class="font-sans text-[13px] font-medium uppercase tracking-[0.06em] text-nav">
          Pérdida estimada al mes
        </p>
        <p class="mt-2 font-serif text-[clamp(32px,4.5vw,52px)] font-semibold text-accent">
          $<span id="calc-result">800.000</span> <span class="text-[16px] font-sans text-body">COP</span>
        </p>
        <p class="mt-2 max-w-xl text-[13px] text-body">
          Estimado asumiendo que cierras 1 de cada 3 clientes que sí logras
          atender a tiempo — un supuesto conservador frente al 78% citado
          arriba.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const ticketInput = document.getElementById("calc-ticket") as HTMLInputElement | null;
  const missedInput = document.getElementById("calc-missed") as HTMLInputElement | null;
  const resultEl = document.getElementById("calc-result");

  const CONVERSION_ASSUMPTION = 1 / 3;
  const DAYS_PER_MONTH = 30;

  function formatNumber(value: number) {
    return Math.round(value).toLocaleString("es-CO");
  }

  function recalculate() {
    const ticket = Number(ticketInput?.value) || 0;
    const missed = Number(missedInput?.value) || 0;
    const loss = ticket * missed * DAYS_PER_MONTH * CONVERSION_ASSUMPTION;
    if (resultEl) {
      resultEl.textContent = formatNumber(loss);
    }
  }

  ticketInput?.addEventListener("input", recalculate);
  missedInput?.addEventListener("input", recalculate);
  recalculate();
</script>
