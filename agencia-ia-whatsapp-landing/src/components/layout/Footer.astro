---
import AillyLogo from "@/components/ui/AillyLogo.astro";
import { AGENCY_NAME, WHATSAPP_URL } from "@/lib/constants";

const year = new Date().getFullYear();

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#solucion", label: "Solución" },
  { href: "#industrias", label: "Industrias" },
  { href: "#faq", label: "Preguntas frecuentes" },
];
---

<footer class="border-t border-accent-muted/15">
  <div class="content-width grid gap-10 py-16 sm:grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <AillyLogo size={28} />
        <span class="font-sans text-[17px] font-bold text-heading">
          Ai<span class="text-accent">lly</span>
        </span>
      </div>
      <p class="mt-4 max-w-xs text-[14px] text-body">
        Tu aliado de IA para negocios — agendamos, respondemos y damos
        seguimiento por WhatsApp para que no pierdas ventas por falta de
        respuesta.
      </p>
    </div>

    <div>
      <p class="font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-heading">
        Navegación
      </p>
      <ul class="mt-4 flex flex-col gap-3">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[14px] text-nav transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-heading">
        Contacto
      </p>
      <ul class="mt-4 flex flex-col gap-3">
        <li>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[14px] text-nav transition-colors hover:text-accent"
          >
            Escríbenos por WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-accent-muted/15">
    <div class="content-width flex flex-col items-center justify-between gap-2 py-6 text-center sm:flex-row sm:text-left">
      <p class="font-sans text-[13px] text-nav">&copy; {year} {AGENCY_NAME}</p>
      <p class="font-sans text-[13px] text-nav">Hecho para negocios que responden rápido.</p>
    </div>
  </div>
</footer>
