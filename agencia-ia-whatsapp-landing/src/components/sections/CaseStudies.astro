                    <MiniStat value="65%" label="Tasa de retorno" tone="accent" />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3.5">
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">🔁 Upsell automático día 25</p>
                    <div class="rounded-lg bg-bg/60 p-2.5">
                      <div class="mb-1.5 rounded-md rounded-bl-sm bg-[#1F2C34] px-2.5 py-2 font-sans text-[11px] leading-relaxed text-[#E9EDF0]">
                        Hola Laura 😊 Hace 25 días tuviste tu limpieza facial. El ciclo recomendado es mensual. ¿Agendamos la próxima?
                      </div>
                      <div class="flex justify-between font-sans text-[9px] text-[#8696A0]"><span>Enviado automático · día 25</span><span>✓✓</span></div>
                    </div>
                  </div>
                  <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                    <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                    <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">⭐ Calificación + Google</p>
                    <div class="rounded-lg bg-bg/60 p-2.5">
                      <div class="mb-1.5 rounded-md rounded-bl-sm bg-[#1F2C34] px-2.5 py-2 font-sans text-[11px] leading-relaxed text-[#E9EDF0]">
                        ¿Cómo quedaste con tu limpieza facial de hoy? 💙 Califica tu experiencia: ⭐⭐⭐⭐⭐
                      </div>
                      <div class="flex justify-between font-sans text-[9px] text-[#8696A0]"><span>Enviado 24h post-servicio</span><span>✓✓</span></div>
                    </div>
                    <div class="mt-2 rounded-md bg-[#4CAF7D]/10 px-2 py-1.5 font-sans text-[10px] text-[#4CAF7D]">
                      ✓ Si califica 5★ → recibe link a Google Reviews automático
                    </div>
                  </div>
                </div>
              </Fragment>
            )}

            {c.id === "huellitas" && (
              <Fragment>
                <div class="relative overflow-hidden rounded-[14px] border border-accent-muted/20 bg-surface-elevated p-4">
                  <span class="absolute inset-y-0 left-0 w-[3px] bg-accent"></span>
                  <p class="mb-2.5 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-accent">🐾 Ficha de mascota — generada automático</p>
                  <div class="rounded-lg bg-bg/40 p-3 font-sans text-[11px]">
                    <div class="mb-2.5 flex items-center justify-between">
                      <span class="text-[13px] font-bold text-heading">Max</span>
                      <span class="rounded-full bg-[#4CAF7D]/10 px-2 py-0.5 text-[9px] font-semibold text-[#4CAF7D]">Al día con vacunas</span>
                    </div>
                    <div class="flex gap-1.5 py-0.5"><span class="w-16 shrink-0 text-body/60">Raza</span><span class="font-medium text-body">Golden Retriever</span></div>
                    <div class="flex gap-1.5 py-0.5"><span class="w-16 shrink-0 text-body/60">Edad</span><span class="font-medium text-body">3 años, 4 meses</span></div>
                    <div class="flex gap-1.5 py-0.5"><span class="w-16 shrink-0 text-body/60">Dueño</span><span class="font-medium text-body">Carlos Mejía</span></div>
                    <div class="flex gap-1.5 py-0.5"><span class="w-16 shrink-0 text-body/60">Última visita</span><span class="font-medium text-body">12 jun 2026</span></div>
