---
// Punto de reemplazo intencional del hero (ver Sección 6 del blueprint).
// HOY: interfaz de chat animada en vivo (CSS + JS ligero, ~2KB) que simula
// una conversación real de WhatsApp con efecto de escritura + indicador de
// "escribiendo...". Si en el futuro se reemplaza por un video grabado,
// este es el único archivo a tocar — mismo contenedor, mismo overlay,
// no tocar Hero.astro. Respeta prefers-reduced-motion y funciona sin JS
// (se queda en el primer intercambio, ya renderizado en el HTML).
---

<div
  class="hero-media-container relative flex min-h-[440px] w-full flex-col overflow-hidden rounded-2xl border border-accent-muted/20 bg-surface-elevated md:min-h-[560px]"
  aria-hidden="true"
>
  <div class="flex items-center gap-3 border-b border-accent-muted/15 px-6 py-5">
    <img
      src="/images/lumiere-logo.webp"
      alt=""
      class="h-10 w-10 shrink-0 rounded-full"
      width="256"
      height="256"
    />
    <div>
      <p class="font-sans text-[14px] font-medium text-heading">Clínica Lumière</p>
      <p class="font-sans text-[12px] text-accent">Agente IA · en línea</p>
    </div>
  </div>

  <div id="chat-log" class="flex flex-1 flex-col justify-end gap-3 overflow-hidden px-6 py-6">
    <div class="bubble bubble--client bubble--visible">¿Tienen disponibilidad este sábado?</div>
    <div class="bubble bubble--agent bubble--visible">¡Claro! Tenemos espacio a las 5pm. ¿Te reservo la cita?</div>
  </div>

  <div class="pointer-events-none absolute inset-0 [background:radial-gradient(120%_120%_at_50%_100%,transparent_40%,rgba(11,14,20,0.5)_100%)]"></div>
</div>

<script>
  const log = document.getElementById("chat-log");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const exchanges = [
    {
      client: "¿Tienen disponibilidad este sábado?",
      agent: "¡Claro! Tenemos espacio a las 5pm. ¿Te reservo la cita?",
    },
    {
      client: "¿Cuánto cuesta la limpieza facial?",
      agent: "Desde $180.000 COP. ¿Te comparto el detalle y agendamos tu cita?",
    },
    {
      client: "¿Atienden los domingos?",
      agent: "Sí, de 9am a 2pm. ¿Te agendo para este domingo?",
    },
  ];

  function sleep(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function makeBubble(kind: "client" | "agent" | "typing") {
    const el = document.createElement("div");
    el.className =
      kind === "typing" ? "bubble bubble--agent bubble--typing" : `bubble bubble--${kind}`;
    log!.appendChild(el);
    requestAnimationFrame(() => el.classList.add("bubble--visible"));
    return el;
  }

  async function typeInto(el: HTMLElement, text: string, speed = 16) {
    for (let i = 0; i < text.length; i++) {
      el.textContent = text.slice(0, i + 1);
      await sleep(speed);
    }
  }

  async function runLoop() {
    while (true) {
      for (const exchange of exchanges) {
        while (log!.children.length >= 4) {
          log!.removeChild(log!.firstChild as ChildNode);
        }

        const clientBubble = makeBubble("client");
        await typeInto(clientBubble, exchange.client);
        await sleep(500);

        const typingBubble = makeBubble("typing");
        typingBubble.innerHTML = "<span></span><span></span><span></span>";
        await sleep(1100);
        log!.removeChild(typingBubble);

        const agentBubble = makeBubble("agent");
        await typeInto(agentBubble, exchange.agent, 14);
        await sleep(1800);
      }
      await sleep(1500);
    }
  }

  if (log && !reduceMotion) {
    log.innerHTML = "";
    runLoop();
  }
</script>
